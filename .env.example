RA_BASE_URL=https://qa-develop.rightanswers.com/portal
RA_COMPANY_CODE=na
RA_APP_INTERFACE=sa
RA_USERNAME=
RA_PASSWORD=
RA_TIMEOUT_MS=30000

OPENAI_API_KEY=
# Remote libSQL database required on Vercel. Leave unset for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Knowledge Studio sign-in (server only; never NEXT_PUBLIC_*)
KS_AUTH_USERNAME=admin
KS_AUTH_PASSWORD=
# Generate a random secret of at least 32 characters.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Keep sauser to retain ownership of existing pilot runs.
KS_AUTH_RA_USER=sauser
# Set these to your deployment URL when using a custom reverse proxy:
# AUTH_URL=https://your-studio.vercel.app
# KS_PUBLIC_ORIGIN=https://your-studio.vercel.app

# Optional autonomous mode. Set on BOTH the app and the separate Node worker.
# Disabled by default; existing guided behavior stays available.
KS_AUTONOMOUS_ENABLED=false
# A self-hosted app and worker can share an absolute local SQLite path:
# KS_DB_PATH=/absolute/path/knowledge-studio.db
